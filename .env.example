# Database Configuration
DATABASE_URL=sqlite:///./trademark_screening.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/trademark_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Gemini API (optional - deterministic fallback used when absent)
GEMINI_API_KEY=

# Similarity Weights (0-1, must sum to 1.0)
WEIGHT_PHONETIC=0.35
WEIGHT_TEXTUAL=0.30
WEIGHT_GOODS=0.35

# Priority Thresholds
THRESHOLD_HIGH=75
THRESHOLD_MEDIUM=50
THRESHOLD_LOW=25

# Secret key for JWT tokens
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
